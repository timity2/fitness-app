# Скопируйте в .env и заполните значениями из Supabase → Project Settings → API.
# В клиент попадает ТОЛЬКО публичный (anon / publishable) ключ.
# service_role ключ сюда не добавлять — он используется только в Edge Functions.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Если переменные не заданы, приложение запускается в локальном демо-режиме
# (данные хранятся только на устройстве, без сервера).
