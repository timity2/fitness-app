# Скопируйте в .env.local. Только публичный (anon / publishable) ключ!
# Права администратора проверяются на сервере (таблица user_roles + RLS + Edge Function),
# поэтому даже с этим ключом обычный пользователь не получит доступ к данным панели.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
